<Window x:Class="УП_01._01_Gusakov323.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:УП_01._01_Gusakov323"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid Background="#F0F0F0">
        <Border Background="White" CornerRadius="8"
                Margin="30" Padding="30">
            <StackPanel>
                <TextBlock Text="Читай, Пиши и не спиши"
                           FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnTabLogin" Content="Вход"
                            Grid.Column="0" Click="BtnTabLogin_Click"/>
                    <Button x:Name="BtnTabRegister" Content="Регистрация"
                            Grid.Column="1" Click="BtnTabRegister_Click"
                            Margin="8,0,0,0"/>
                </Grid>
                <StackPanel x:Name="PanelLogin">
                    <TextBlock Text="Логин" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLoginLogin" Margin="0,0,0,10" Padding="6"/>

                    <TextBlock Text="Пароль" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtLoginPassword"
                                 Margin="0,0,0,16" Padding="6"/>

                    <Button Content="Войти" Click="BtnLogin_Click"
                            Background="#3498DB" Foreground="White"
                            Padding="0,8"/>
                </StackPanel>
                <StackPanel x:Name="PanelRegister" Visibility="Collapsed">
                    <TextBlock Text="Логин" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRegLogin" Margin="0,0,0,10" Padding="6"/>

                    <TextBlock Text="Отображаемое имя" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRegName" Margin="0,0,0,10" Padding="6"/>

                    <TextBlock Text="Email" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRegEmail" Margin="0,0,0,10" Padding="6"/>

                    <TextBlock Text="Пароль" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtRegPassword"
                                 Margin="0,0,0,16" Padding="6"/>

                    <Button Content="Зарегистрироваться"
                            Click="BtnRegister_Click"
                            Background="#27AE60" Foreground="White"
                            Padding="0,8"/>
                </StackPanel>
                <TextBlock x:Name="TxtError" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
