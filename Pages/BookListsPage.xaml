<Page x:Class="УП_01._01_Gusakov323.Pages.BookListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:УП_01._01_Gusakov323.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookListsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои списки"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <Button Content="В планах" Margin="0,0,8,0"
                    Padding="12,6" Click="BtnSection_Click"
                    Tag="В планах"/>
            <Button Content="Читаю" Margin="0,0,8,0"
                    Padding="12,6" Click="BtnSection_Click"
                    Tag="Читаю"/>
            <Button Content="Прочитано" Margin="0,0,8,0"
                    Padding="12,6" Click="BtnSection_Click"
                    Tag="Прочитано"/>
            <Button Content="Заброшено"
                    Padding="12,6" Click="BtnSection_Click"
                    Tag="Заброшено"/>
        </WrapPanel>

        <TextBox Grid.Row="2" x:Name="TxtSearch"
                 Padding="8,6" Margin="0,0,0,12"
                 Text="Поиск..." Foreground="Gray"
                 GotFocus="TxtSearch_GotFocus"
                 LostFocus="TxtSearch_LostFocus"
                 TextChanged="TxtSearch_TextChanged"/>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Margin="8"
                                Background="White"
                                CornerRadius="8" Padding="12"
                                Cursor="Hand"
                                MouseLeftButtonUp="BookCard_Click">
                            <StackPanel>
                                <Border Background="#D5E8F5"
                                        Height="100" CornerRadius="6"
                                        Margin="0,0,0,8"
                                        ClipToBounds="True">
                                    <Image Source="{Binding CoverPath}"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AuthorName}"
                                           Foreground="Gray"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                                <ComboBox Tag="{Binding ReadingListId}"
                                          Margin="0,8,0,0" Padding="4"
                                          SelectedValue="{Binding Section}"
                                          SelectionChanged="CmbMoveSection_Changed">
                                    <ComboBoxItem Content="В планах"/>
                                    <ComboBoxItem Content="Читаю"/>
                                    <ComboBoxItem Content="Прочитано"/>
                                    <ComboBoxItem Content="Заброшено"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
