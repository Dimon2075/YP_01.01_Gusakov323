<Page x:Class="УП_01._01_Gusakov323.Pages.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:УП_01._01_Gusakov323.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditBookPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <Button Content="← Назад" HorizontalAlignment="Left"
                    Padding="10,6" Margin="0,0,0,16"
                    Click="BtnBack_Click"/>

            <TextBlock x:Name="TxtPageTitle" FontSize="20"
                       FontWeight="Bold" Margin="0,0,0,20"/>

            <Border Background="White" Padding="20" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Название" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTitle" Padding="8,6"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Описание" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDescription" Padding="8,6"
                             Height="80" TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Текст книги" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtContent" Padding="8,6"
                             Height="150" TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Ссылка на обложку"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCoverPath" Padding="8,6"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Жанры (выбери один или несколько)"
                               Margin="0,0,0,8"/>
                    <ListBox x:Name="GenresList" Height="120"
                             SelectionMode="Multiple"
                             Margin="0,0,0,16"
                             DisplayMemberPath="Name"/>

                    <Button x:Name="BtnSave" Content="Сохранить"
                            Padding="12,8" HorizontalAlignment="Left"
                            Click="BtnSave_Click"
                            Background="#3498DB" Foreground="White"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
